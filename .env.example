# Copie este arquivo para .env.local e preencha com suas chaves

# GNews API (obrigatório) - https://gnews.io/
GNEWS_API_KEY=sua_chave_gnews_aqui

# NewsAPI (opcional - para sistema híbrido futuro) - https://newsapi.org/
# NEWSAPI_KEY=sua_chave_newsapi_aqui

# PostgreSQL (use the same local values from ../fintech-api/.env.development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Produção: a integração Neon da Vercel fornece esta variável como segredo.
# DATABASE_URL=postgresql://...
